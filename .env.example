# ============================================================
# GreenSync — Local Development Environment Template
# Copy this file to .env in each artifact directory as needed.
# NEVER commit .env files — they are gitignored.
# ============================================================

# -- Database (required) -------------------------------------
# Provide the PostgreSQL connection string from Replit or your
# local Postgres instance.
DATABASE_URL=postgresql://user:password@localhost:5432/greensync

# -- Auth (required) -----------------------------------------
# Any random string works for local dev; change in production.
JWT_SECRET=local-dev-jwt-secret-change-me
SESSION_SECRET=local-dev-session-secret-change-me
ADMIN_JWT_SECRET=local-dev-admin-jwt-secret-change-me

# -- Server --------------------------------------------------
PORT=8080
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# -- Stripe (optional for local dev) -------------------------
# Leave blank to disable billing features in local dev.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -- Twilio SMS (optional) -----------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# -- Email (optional) ----------------------------------------
EMAIL_PROVIDER_API_KEY=
