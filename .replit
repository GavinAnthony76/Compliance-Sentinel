modules = ["nodejs-24", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = []

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["nano"]

[userenv]

[userenv.shared]
RESEND_FROM_EMAIL = "noreply@greensynk.com"
STRIPE_STARTER_PRICE_ID = "price_1Tg8lIJc1EWYOrCt1OA2H6TN"
STRIPE_GROWTH_PRICE_ID = "price_1Tg8lIJc1EWYOrCtRHwWPFML"
STRIPE_PRO_PRICE_ID = "price_1Tg8lIJc1EWYOrCtO98FXhMF"
STRIPE_V2_WEBHOOK_SECRET = "whsec_cq4zZEbaEd2HMb4OMabX3YTHORehXESI"
APP_BASE_URL = "https://greensynk.com"
