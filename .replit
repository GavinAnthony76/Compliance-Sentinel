modules = ["nodejs-24", "postgresql-16", "python-3.11"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "lead-access"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "staff-access"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "admin-access"

[[workflows.workflow]]
name = "lead-access"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:permissions:ci"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "staff-access"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:access:ci"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "admin-access"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:admin:ci"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = []

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[nix]
channel = "stable-25_05"
packages = ["nano", "dig"]

[userenv]

[userenv.shared]
RESEND_FROM_EMAIL = "noreply@greensynk.com"
STRIPE_STARTER_PRICE_ID = "price_1Tg8lIJc1EWYOrCt1OA2H6TN"
STRIPE_GROWTH_PRICE_ID = "price_1Tg8lIJc1EWYOrCtRHwWPFML"
STRIPE_PRO_PRICE_ID = "price_1Tg8lIJc1EWYOrCtO98FXhMF"
STRIPE_V2_WEBHOOK_SECRET = ""  # ROTATED: secret was exposed in git — set a new value from the Stripe Dashboard → Developers → Webhooks
APP_BASE_URL = "https://greensynk.com"
FRONTEND_URL = "https://greensynk.com"
