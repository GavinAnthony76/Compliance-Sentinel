modules = ["nodejs-24", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0", "sendgrid:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
RESEND_FROM_EMAIL = "noreply@greensynk.com"
STRIPE_STARTER_PRICE_ID = "price_1Tg7hjRaRIkwxM43h1PsCIha"
STRIPE_GROWTH_PRICE_ID = "price_1Tg7hjRaRIkwxM43m0IJjlG3"
STRIPE_PRO_PRICE_ID = "price_1Tg7hkRaRIkwxM43zuuD86fA"
